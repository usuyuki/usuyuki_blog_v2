# ここはdocker-compose用の環境変数置き場

# Ghost用
BACKEND_API_URL=http://localhost:1001

# Astro用
GHOST_CONTENT_KEY=YOUR_API_KEY
FRONTEND_URL=https://blog.usuyuki.net
GHOST_API_URL=http://localhost:1001

TUNNEL_TOKEN=

# 絵文字リアクション機能用（任意）
# NSFWな絵文字をブロックする場合、カンマ区切りで指定（未設定の場合はブロックなし）
REACTIONS_NSFW_BLOCKLIST=⭐️,🖕

# 執筆者用ページ（/dev配下。グラフのプレビューなど）のBasic認証（任意）
# 本番で/dev配下を開くときのユーザー名とパスワード。未設定なら本番では/dev配下が404になる（開発環境では認証なしで開ける）
DEV_PAGES_BASIC_AUTH_USER=
DEV_PAGES_BASIC_AUTH_PASSWORD=

# RSS統合用（任意）
# 外部ブログのRSSフィードを統合する場合の設定
# JSON配列形式で指定
# color: Tailwind色クラス（例: "bg-green-500"）または16進数カラー（例: "#55c500"）
# qiitaUserId: QiitaはAPIで全記事取得（rssUrlより優先）
# rssUrl: Qiita以外はRSSフィードを指定
EXTERNAL_BLOGS=[{"name":"Qiita","qiitaUserId":"username","color":"#55c500"},{"name":"Zenn","rssUrl":"https://zenn.dev/username/feed","color":"#3ea8ff"},{"name":"note","rssUrl":"https://note.com/username/rss","color":"#41c9b4"}]
