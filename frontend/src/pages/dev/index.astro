---
// 執筆者だけが使うページ(/dev配下)の一覧。
// 本番ではmiddleware.tsのBasic認証(未設定なら404)で保護される。ページを増やしたらDEV_PAGESに足す
import PageHead from "~/components/atom/section/PageHead.astro";
import PageLayout from "~/layouts/extends/PageLayout.astro";
import { buildFixedOgpMeta } from "~/libs/helper/ogpMeta";
import type { HeadMetaType } from "~/types/HeadMetaType";

const DEV_PAGES = [
  {
    href: "/dev/chart-preview",
    title: "グラフのプレビュー",
    description: "chartコードブロックのJSONを、記事本文と同じ見た目で描画する",
  },
];

const headMeta: HeadMetaType = {
  title: "執筆者用ページ",
  slug: "/dev",
  description: "執筆者用ページの一覧",
  ...buildFixedOgpMeta(),
};
---

<PageLayout {...headMeta}>
	<PageHead en="Dev" jp="執筆者用ページ" />
	<ul class="container dev-pages">
		{DEV_PAGES.map((page) => (
			<li>
				<a href={page.href}>
					<span class="title">{page.title}</span>
					<span class="description">{page.description}</span>
				</a>
			</li>
		))}
	</ul>
</PageLayout>

<style>
	.dev-pages {
		list-style: none;
		padding-top: 32px;
		padding-bottom: 80px;
		display: grid;
		gap: 12px;
	}
	.dev-pages a {
		display: block;
		border: var(--bw) solid var(--color-ink);
		padding: 16px 20px;
		transition:
			background 0.15s,
			color 0.15s;
	}
	.dev-pages a:hover {
		background: var(--color-ink);
		color: var(--color-paper);
	}
	.title {
		display: block;
		font-family: var(--font-ja-heading);
		font-weight: 700;
	}
	.description {
		display: block;
		margin-top: 4px;
		font-size: 0.85rem;
	}
</style>
