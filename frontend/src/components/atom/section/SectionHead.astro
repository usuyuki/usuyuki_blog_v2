---
// セクション見出し(巨大英字 + 日本語サブ見出し + 任意のリンクボタン)
// size="compact"は英字と日本語を1行に並べた小さい見出し。記事詳細下部の最近の記事・関連記事のように、
// 本文を読み終えた後の補助的なセクションで巨大英字が主張しすぎないようにするため使う
interface Props {
  en: string;
  jp: string;
  linkHref?: string;
  linkLabel?: string;
  headingId?: string;
  size?: "large" | "compact";
}
const { en, jp, linkHref, linkLabel, headingId, size = "large" } = Astro.props;
---

<div class:list={["section-head", { compact: size === "compact" }]}>
	<h2 class="section-title" id={headingId}>
		<span class="en">{en}</span>
		<span class="jp">{jp}</span>
	</h2>
	{
		linkHref && linkLabel && (
			<a class="section-link" href={linkHref}>
				{linkLabel}
			</a>
		)
	}
</div>

<style>
	.section-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 20px;
		padding: 56px 0 24px;
	}
	.section-title .en {
		display: block;
		font-family: var(--font-display);
		font-weight: 900;
		font-size: clamp(2rem, 5.5vw, 3.4rem);
		letter-spacing: 0.01em;
		line-height: 1.05;
		text-transform: uppercase;
	}
	.section-title .jp {
		display: inline-block;
		margin-top: 8px;
		font-size: 0.8rem;
		font-weight: 700;
		border-left: 4px solid var(--color-ink);
		padding-left: 10px;
	}
	.compact {
		padding: 40px 0 16px;
	}
	.compact .section-title {
		display: flex;
		align-items: baseline;
		gap: 12px;
	}
	.compact .section-title .en {
		font-size: 1rem;
		letter-spacing: 0.16em;
	}
	.compact .section-title .jp {
		margin-top: 0;
		font-size: 0.75rem;
		border-left: none;
		padding-left: 0;
		color: var(--color-muted-dark);
	}
	.section-link {
		font-family: var(--font-en);
		font-weight: 700;
		font-size: 0.78rem;
		letter-spacing: 0.16em;
		border: var(--bw) solid var(--color-ink);
		padding: 10px 20px;
		white-space: nowrap;
		transition:
			background 0.15s,
			color 0.15s;
	}
	.section-link:hover {
		background: var(--color-ink);
		color: var(--color-paper);
	}
</style>
